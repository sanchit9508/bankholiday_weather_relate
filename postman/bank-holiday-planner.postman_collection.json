{
  "info": {
    "name": "Bank Holiday Planner",
    "description": "Source APIs and the planner API. Run with the local environment and set apiKey to PLANNER_API_KEY.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-API-Key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "item": [
    {
      "name": "Source APIs",
      "auth": {
        "type": "noauth"
      },
      "item": [
        {
          "name": "GOV.UK bank holidays",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"has all three divisions\", function () {",
                  "  pm.expect(pm.response.json()).to.have.all.keys('england-and-wales', 'scotland', 'northern-ireland');",
                  "});",
                  "pm.test(\"events have a title and ISO date\", function () {",
                  "  pm.response.json()['scotland'].events.forEach((event) => {",
                  "    pm.expect(event.title).to.be.a('string');",
                  "    pm.expect(event.date).to.match(/^\\d{4}-\\d{2}-\\d{2}$/);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "https://www.gov.uk/bank-holidays.json",
            "header": []
          }
        },
        {
          "name": "Open-Meteo forecast",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"returns 16 days\", function () {",
                  "  pm.expect(pm.response.json().daily.time).to.have.lengthOf(16);",
                  "});",
                  "pm.test(\"columns line up\", function () {",
                  "  const { daily } = pm.response.json();",
                  "  pm.expect(daily.temperature_2m_max).to.have.lengthOf(daily.time.length);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "https://api.open-meteo.com/v1/forecast?latitude=51.51&longitude=-0.13&timezone=Europe%2FLondon&forecast_days=16&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,precipitation_probability_max",
            "header": []
          }
        },
        {
          "name": "Open-Meteo seasonal ensemble",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"returns ensemble members\", function () {",
                  "  pm.expect(pm.response.json().daily).to.have.property('temperature_2m_max_member50');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "https://seasonal-api.open-meteo.com/v1/seasonal?latitude=51.51&longitude=-0.13&timezone=Europe%2FLondon&forecast_days=217&daily=temperature_2m_max,temperature_2m_min,precipitation_sum",
            "header": []
          }
        },
        {
          "name": "Country info (SOAP)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"body is the expected SOAP result\", function () {",
                  "  pm.expect(pm.response.text()).to.include('FullCountryInfoResult');",
                  "  pm.expect(pm.response.text()).to.include('United Kingdom');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "http://webservices.oorsprong.org/websamples.countryinfo/CountryInfoService.wso",
            "header": [
              {
                "key": "Content-Type",
                "value": "text/xml; charset=utf-8"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "<?xml version=\"1.0\" encoding=\"utf-8\"?>\n<soap:Envelope xmlns:soap=\"http://schemas.xmlsoap.org/soap/envelope/\">\n  <soap:Body>\n    <FullCountryInfo xmlns=\"http://www.oorsprong.org/websamples.countryinfo\"><sCountryISOCode>GB</sCountryISOCode></FullCountryInfo>\n  </soap:Body>\n</soap:Envelope>",
              "options": {
                "raw": {
                  "language": "xml"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Planner API",
      "item": [
        {
          "name": "Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"reports ok\", function () {",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Holidays (defaults)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"responds quickly\", function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(500);",
                  "});",
                  "pm.test(\"has rate limit headers\", function () {",
                  "  pm.expect(pm.response.headers.has('RateLimit')).to.be.true;",
                  "});",
                  "pm.test(\"returns the next five in date order\", function () {",
                  "  const { holidays, count } = pm.response.json();",
                  "  pm.expect(count).to.eql(5);",
                  "  const dates = holidays.map((holiday) => holiday.date);",
                  "  pm.expect(dates).to.eql([...dates].sort());",
                  "  pm.expect(holidays[0].daysUntil).to.be.at.least(0);",
                  "});",
                  "pm.test(\"every holiday says where its weather came from\", function () {",
                  "  pm.response.json().holidays.forEach(({ weather }) => {",
                  "    pm.expect(weather.source).to.be.oneOf(['forecast', 'climate', 'seasonal', 'unavailable']);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/holidays",
            "header": []
          }
        },
        {
          "name": "Holidays (Scotland, limit 3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"applies both filters\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.division).to.eql('scotland');",
                  "  pm.expect(body.location.name).to.eql('Edinburgh');",
                  "  pm.expect(body.holidays).to.have.lengthOf(3);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/holidays?division=scotland&limit=3",
            "header": []
          }
        },
        {
          "name": "Country as JSON (SOAP wrapped)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"maps SOAP fields to JSON\", function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.capital).to.eql('London');",
                  "  pm.expect(body.currencyCode).to.eql('GBP');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/countries/gb",
            "header": []
          }
        },
        {
          "name": "Rejects missing key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"error is problem+json\", function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.all.keys('title', 'status', 'detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/holidays",
            "header": [],
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Rejects unknown division",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"error is problem+json\", function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.all.keys('title', 'status', 'detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/holidays?division=wales",
            "header": []
          }
        },
        {
          "name": "Rejects limit over 10",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"error is problem+json\", function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.all.keys('title', 'status', 'detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/holidays?limit=11",
            "header": []
          }
        },
        {
          "name": "Rejects malformed country code",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 400\", function () {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"error is problem+json\", function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.all.keys('title', 'status', 'detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/countries/G1",
            "header": []
          }
        },
        {
          "name": "Unknown country is a 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 404\", function () {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test(\"error is problem+json\", function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.all.keys('title', 'status', 'detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/countries/ZZ",
            "header": []
          }
        },
        {
          "name": "Ingest refuses the read key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 401\", function () {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test(\"error is problem+json\", function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.all.keys('title', 'status', 'detail');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/ingest",
            "header": []
          }
        }
      ]
    }
  ]
}
